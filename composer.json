{
    "name": "php-baremetal/phpbm",
    "description": "PHP BareMetal: build, flash and monitor PHP firmware for microcontrollers.",
    "keywords": [
        "php-baremetal",
        "firmware",
        "cli"
    ],
    "homepage": "https://github.com/php-baremetal/phpbm",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Gianfrancesco Aurecchia",
            "email": "gianfri@php-baremetal.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-fileinfo": "*",
        "composer/semver": "^3.4",
        "laravel-zero/foundation": "^13.23",
        "laravel-zero/framework": "^13.0",
        "php-baremetal/spec": "^1.1"
    },
    "require-dev": {
        "laravel/pint": "^1.30.4",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^4.7.8 || ^5.0.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "bin": [
        "phpbm"
    ]
}
